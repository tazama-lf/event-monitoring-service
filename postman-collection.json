{
  "info": {
    "name": "Event Monitoring Service API",
    "description": "Complete API collection for Event Monitoring Service (DEMS) including TCS Simulation and Config Notify endpoints",
    "version": "1.0.0",
    "_postman_id": "dems-api-collection-2025",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "demo-bank",
      "type": "string"
    },
    {
      "key": "configId",
      "value": "test-config-001",
      "type": "string"
    },
    {
      "key": "version",
      "value": "v1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Health check endpoint returning application status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "TCS Simulation",
      "item": [
        {
          "name": "Create Configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configId\": \"{{configId}}\",\n  \"version\": \"{{version}}\",\n  \"tenantId\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tcs-simulation/create-config",
              "host": ["{{baseUrl}}"],
              "path": ["tcs-simulation", "create-config"]
            },
            "description": "Creates a new configuration and publishes notification to NATS for automatic caching"
          },
          "response": []
        },
        {
          "name": "Get Single Configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tcs-simulation/configs/{{configId}}?tenantId={{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tcs-simulation", "configs", "{{configId}}"],
              "query": [
                {
                  "key": "tenantId",
                  "value": "{{tenantId}}"
                }
              ]
            },
            "description": "Retrieves a specific configuration by configId and tenantId"
          },
          "response": []
        },
        {
          "name": "Get All Configurations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tcs-simulation/configs",
              "host": ["{{baseUrl}}"],
              "path": ["tcs-simulation", "configs"]
            },
            "description": "Retrieves all configurations from the database"
          },
          "response": []
        },
        {
          "name": "Get All Configurations by Tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tcs-simulation/configs?tenantId={{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tcs-simulation", "configs"],
              "query": [
                {
                  "key": "tenantId",
                  "value": "{{tenantId}}"
                }
              ]
            },
            "description": "Retrieves all configurations for a specific tenant"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Config Notify (Internal)",
      "item": [
        {
          "name": "Manual Notify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configId\": \"{{configId}}\",\n  \"version\": \"{{version}}\",\n  \"tenantId\": \"{{tenantId}}\",\n  \"action\": \"ADDED\",\n  \"timestamp\": \"2025-09-25T12:00:00.000Z\",\n  \"artifactLink\": \"https://example.com/configs/test-config.json\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/internal/config/notify",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "notify"]
            },
            "description": "Manually notify DEMS to cache a configuration (normally triggered automatically via NATS)"
          },
          "response": []
        },
        {
          "name": "Check Cache for Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/config/cache/check/{{tenantId}}/{{configId}}/{{version}}",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "cache", "check", "{{tenantId}}", "{{configId}}", "{{version}}"]
            },
            "description": "Checks if a specific configuration is cached in Redis"
          },
          "response": []
        },
        {
          "name": "Get Tenant Cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/config/cache/tenant/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "cache", "tenant", "{{tenantId}}"]
            },
            "description": "Retrieves all cached configurations for a specific tenant"
          },
          "response": []
        },
        {
          "name": "Get All Cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/config/cache/all",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "cache", "all"]
            },
            "description": "Retrieves all cached configurations from Redis"
          },
          "response": []
        },
        {
          "name": "Clear All Cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/config/cache/clear",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "cache", "clear"]
            },
            "description": "Clears all cached configurations from Redis"
          },
          "response": []
        },
        {
          "name": "Clear Cache by Pattern",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/config/cache/clear?pattern={{tenantId}}:{{configId}}:*",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "config", "cache", "clear"],
              "query": [
                {
                  "key": "pattern",
                  "value": "{{tenantId}}:{{configId}}:*"
                }
              ]
            },
            "description": "Clears cached configurations matching a specific pattern"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sample Test Flows",
      "item": [
        {
          "name": "Complete E2E Test Flow",
          "item": [
            {
              "name": "1. Create Test Configuration",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"configId\": \"e2e-test-config\",\n  \"version\": \"v1.0.0\",\n  \"tenantId\": \"e2e-tenant\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/tcs-simulation/create-config",
                  "host": ["{{baseUrl}}"],
                  "path": ["tcs-simulation", "create-config"]
                },
                "description": "Step 1: Create configuration (triggers automatic NATS publishing)"
              },
              "response": []
            },
            {
              "name": "2. Verify Database Record",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/tcs-simulation/configs/e2e-test-config?tenantId=e2e-tenant",
                  "host": ["{{baseUrl}}"],
                  "path": ["tcs-simulation", "configs", "e2e-test-config"],
                  "query": [
                    {
                      "key": "tenantId",
                      "value": "e2e-tenant"
                    }
                  ]
                },
                "description": "Step 2: Verify configuration exists in database"
              },
              "response": []
            },
            {
              "name": "3. Check Auto Cache",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/internal/config/cache/check/e2e-tenant/e2e-test-config/v1.0.0",
                  "host": ["{{baseUrl}}"],
                  "path": ["internal", "config", "cache", "check", "e2e-tenant", "e2e-test-config", "v1.0.0"]
                },
                "description": "Step 3: Verify automatic caching via NATS consumer"
              },
              "response": []
            },
            {
              "name": "4. Clear Test Cache",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/internal/config/cache/clear?pattern=e2e-tenant:e2e-test-config:*",
                  "host": ["{{baseUrl}}"],
                  "path": ["internal", "config", "cache", "clear"],
                  "query": [
                    {
                      "key": "pattern",
                      "value": "e2e-tenant:e2e-test-config:*"
                    }
                  ]
                },
                "description": "Step 4: Clean up test cache data"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Batch Operations",
          "item": [
            {
              "name": "Create Multiple Configs",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"configId\": \"batch-config-{{$randomInt}}\",\n  \"version\": \"v1.{{$randomInt}}\",\n  \"tenantId\": \"batch-tenant-{{$randomInt}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/tcs-simulation/create-config",
                  "host": ["{{baseUrl}}"],
                  "path": ["tcs-simulation", "create-config"]
                },
                "description": "Create configuration with random values for batch testing"
              },
              "response": []
            },
            {
              "name": "View All Configurations",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/tcs-simulation/configs",
                  "host": ["{{baseUrl}}"],
                  "path": ["tcs-simulation", "configs"]
                },
                "description": "View all configurations in the system"
              },
              "response": []
            },
            {
              "name": "View All Cache Entries",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/internal/config/cache/all",
                  "host": ["{{baseUrl}}"],
                  "path": ["internal", "config", "cache", "all"]
                },
                "description": "View all cache entries"
              },
              "response": []
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ]
}
