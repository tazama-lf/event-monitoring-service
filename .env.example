# SPDX-License-Identifier: Apache-2.0

# Application Configuration
FUNCTION_NAME="event-monitoring-service"
NODE_ENV="development"
MAX_CPU=1
APP_PORT=3002

# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=event_monitoring_dev

# Database Connection Pool Configuration (Optional)
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=10000
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis Configuration (Required)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# NATS Configuration (frms-coe-startup-lib)
SERVER_URL=localhost:4222
STARTUP_TYPE=nats
PRODUCER_STREAM=config.notification
CONSUMER_STREAM=config.notification
STREAM_SUBJECT=config.notification

# Cache Configuration
CACHE_TTL=3600